{
  "appId": "com.palmaselite.gymmember",
  "appName": "Palma's Elite Gym",
  "webDir": "www",
  "server": {
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#061F18",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": true,
      "spinnerColor": "#55D69A"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#061F18"
    }
  }
}
