# ==============================================================================
# PALMA'S ELITE GYM MANAGEMENT SYSTEM - PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (located outside public webroot or in project root)
# Ensure .env is NEVER committed to version control and permissions are 0600.
# ==============================================================================

# Environment: 'production' or 'development'
APP_ENV=production

# Base URL of the application (NO trailing slash)
# Replace placeholder with your actual production domain
APP_URL=https://YOUR-DOMAIN.example

# ------------------------------------------------------------------------------
# DATABASE CREDENTIALS (Dedicated least-privilege user recommended)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gym_management
DB_USER=palmas_gym_user
DB_PASS=REPLACE_WITH_SECURE_DATABASE_PASSWORD

# ------------------------------------------------------------------------------
# SECURITY KEYS & TOKENS (Generate using: bin2hex(random_bytes(32)))
# ------------------------------------------------------------------------------
# Secret key for HMAC-SHA256 dynamic QR generation (min 32 characters)
QR_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHIC_QR_SECRET_KEY_MIN_32_CHARS

# Kiosk device API key for attendance scanner integration
KIOSK_API_KEY=REPLACE_WITH_CRYPTOGRAPHIC_KIOSK_API_KEY

# Secret key to secure daily maintenance cron job triggers via web
CRON_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHIC_CRON_SECRET_KEY

# ------------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=palmaselitegym.system@gmail.com
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=palmaselitegym.system@gmail.com
SMTP_FROM_NAME="Palma's Elite Gym"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 CONFIGURATION
# Get your Client ID from: https://console.cloud.google.com
# Create Project → APIs & Services → Credentials → OAuth 2.0 Client ID
# Add your Render domain to Authorized JavaScript Origins
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# PAYMENT MODE
# 'demo'  = Instant activation (no real gateway verification — safe for testing)
# 'live'  = Requires real PayMongo/GCash webhook to confirm payment before activation
# ------------------------------------------------------------------------------
PAYMENT_MODE=demo

# ------------------------------------------------------------------------------
# SYSTEM BINARY OVERRIDES (Optional: leave blank for system PATH auto-detection)
# ------------------------------------------------------------------------------
MYSQLDUMP_PATH=
MYSQL_PATH=

